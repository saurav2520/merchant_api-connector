# =====================================================================
# Merchant AI Connector - Environment Configuration Example
# =====================================================================

# [REQUIRED] Merchant WooCommerce Store URL (HTTPS strictly required in production)
WP_URL=https://shop.example.com

# [REQUIRED] WooCommerce REST API Credentials (Read-only permissions)
# Generate in WooCommerce -> Settings -> Advanced -> REST API -> Add key
WC_CONSUMER_KEY=ck_your_read_only_consumer_key
WC_CONSUMER_SECRET=cs_your_read_only_consumer_secret

# [SECURITY] Enforce HTTPS and SSRF protection (Default: false). Set true ONLY for local dev/mock tests.
ALLOW_INSECURE_HTTP=false

# [RESILIENCE] HTTP Request timeout in milliseconds (Default: 10000)
REQUEST_TIMEOUT_MS=10000

# [RESILIENCE] Max automatic retries for transient upstream failures (429, 502, 503, 504)
MAX_RETRIES=2

# [RATE LIMITING] In-memory rate limiting quotas per merchant
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20

# [PRIVACY] Mask customer emails and redact sensitive personal information
MASK_CUSTOMER_PII=true

# [OBSERVABILITY] Logging level (DEBUG, INFO, WARN, ERROR). All logs emit to stderr.
LOG_LEVEL=INFO
